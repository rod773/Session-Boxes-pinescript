//@version=6
indicator('Session Boxes (Asia, London, NY) — Custom Timezone', overlay = true)

//-----------------------------
// Inputs
//-----------------------------
asiaSess   = input.session('0100-0900', 'Asia session (local time)')
asiaColor  = input.color(color.yellow, 'Asia color')

lonSess    = input.session('0800-1700', 'London session (local time)')
lonColor   = input.color(color.blue, 'London color')

nySess     = input.session('1400-2200', 'New York session (local time)')
nyColor    = input.color(color.purple, 'New York color')

boxTransp  = input.int(85, 'Box transparency (0-100)')
lineStyle  = input.string('solid', 'Vertical line style', options = ['solid', 'dashed', 'dotted'])

// Timezone selector
tzChoice   = input.string('Europe/Madrid', 'Timezone', options = ['Europe/Madrid', 'Europe/London', 'Asia/Tokyo', 'America/New_York'])

//-----------------------------
// Style resolver
//-----------------------------
styleFromStr(str) =>
    str == 'dashed' ? line.style_dashed : str == 'dotted' ? line.style_dotted : line.style_solid

ls = styleFromStr(lineStyle)

//-----------------------------
// Session helpers (use selected timezone)
//-----------------------------
inSession(sess) =>
    not na(time(timeframe.period, sess + ':1234567', tzChoice))

entered(cond) =>
    cond and not cond[1]

exited(cond) =>
    not cond and cond[1]

//-----------------------------
// Storage
//-----------------------------
var float asiaHigh = na
var float asiaLow  = na
var int   asiaStart = na
var box   asiaBox = na

var float lonHigh  = na
var float lonLow   = na
var int   lonStart = na
var box   lonBox = na

var float nyHigh   = na
var float nyLow    = na
var int   nyStart  = na
var box   nyBox = na

//-----------------------------
// Asia
//-----------------------------
asiaIn = inSession(asiaSess)

if entered(asiaIn)
    asiaHigh  := high
    asiaLow   := low
    asiaStart := bar_index
    asiaBox   := box.new(asiaStart, asiaHigh, bar_index, asiaLow,
                         xloc = xloc.bar_index, border_color = asiaColor,
                         bgcolor = color.new(asiaColor, boxTransp))
    line.new(bar_index, close, bar_index, close, xloc = xloc.bar_index,
             extend = extend.none, color = asiaColor, width = 1, style = ls)

if asiaIn and not na(asiaBox)
    asiaHigh := math.max(asiaHigh, high)
    asiaLow  := math.min(asiaLow, low)
    box.set_top(asiaBox, asiaHigh)
    box.set_bottom(asiaBox, asiaLow)
    box.set_right(asiaBox, bar_index)

if exited(asiaIn) and not na(asiaBox)
    line.new(bar_index, close, bar_index, close, xloc = xloc.bar_index,
             extend = extend.none, color = asiaColor, width = 1, style = ls)
    float midY = (asiaHigh + asiaLow) / 2.0
    int midX   = int(math.round((asiaStart + bar_index) / 2.0))
    label.new(midX, midY, 'ASIA', style = label.style_label_center,
              color = color.new(color.white, 100), textcolor = asiaColor, size = size.large)
    asiaHigh  := na
    asiaLow   := na
    asiaStart := na
    asiaBox   := na

//-----------------------------
// London
//-----------------------------
londonIn = inSession(lonSess)

if entered(londonIn)
